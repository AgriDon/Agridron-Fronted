# AgriDron Solutions - environment variables template
# Copy to .env.development / .env.production and fill in real values.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# Do NOT put secrets here: anything VITE_* ships inside the built JS.

# Base URL of the API. Relative ("/api/v1") in development: the Vite dev
# server proxies it to VITE_DEV_PROXY_TARGET. Absolute in production.
VITE_API_BASE_URL="/api/v1"

# Proxy target used only by the Vite dev server (never bundled).
VITE_DEV_PROXY_TARGET="http://localhost:3000"

# Authentication
VITE_SIGNIN_ENDPOINT_PATH="/authentication/sign-in"
VITE_SIGNUP_ENDPOINT_PATH="/authentication/sign-up"
VITE_USERS_ENDPOINT_PATH="/users"

# Farm management
VITE_FARMS_ENDPOINT_PATH="/farms"
VITE_PARCELS_ENDPOINT_PATH="/parcels"
VITE_CROPS_ENDPOINT_PATH="/crops"
VITE_MISSIONS_ENDPOINT_PATH="/missions"
VITE_FUMIGATION_AREAS_ENDPOINT_PATH="/fumigation-areas"

# Missions
VITE_MISSION_REPORTS_ENDPOINT_PATH="/mission-reports"
VITE_MISSION_HISTORIES_ENDPOINT_PATH="/mission-histories"

# Drones & equipment
VITE_DRONES_METRICS_ENDPOINT_PATH="/drones"
VITE_INCIDENTS_METRICS_ENDPOINT_PATH="/incidents"
VITE_OPERATIONSTATUS_METRICS_ENDPOINT_PATH="/operations"
VITE_CHEMICALS_ENDPOINT_PATH="/chemicals"
VITE_NOZZLES_ENDPOINT_PATH="/nozzles"
VITE_MAINTENANCE_RECORDS_ENDPOINT_PATH="/maintenance"
VITE_MAINTINANCE_RECORDS_ENDPOINT_PATH="/maintenance"

# Metrics
VITE_OPERATIONAL_METRICS_ENDPOINT_PATH="/operational-metrics"
VITE_PERFORMANCE_INDICATORS_ENDPOINT_PATH="/performance-indicators"

# Weather
VITE_WEATHER_ENDPOINT_PATH="/weather"

# Prime UI license key (community tier)
VITE_PRIME_UI_LICENSE_KEY=""